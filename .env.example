# Copy this file to .env and fill in real values.

# --- Database ---
# SQLite for local/dev. For production swap to Postgres, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/mayaslodge"
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Long random string. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Admin bootstrap (used only by the seed script) ---
ADMIN_EMAIL="maya@mayaslodge.ie"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Maya"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
