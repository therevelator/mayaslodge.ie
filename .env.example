# Copy this file to .env and fill in real values.

# --- Database ---
# Postgres (e.g. Neon). Use the *pooled* connection string for DATABASE_URL
# and the *direct* (non-pooled) one for DIRECT_URL.
DATABASE_URL="postgresql://user:pass@host-pooler/mayaslodge?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/mayaslodge?sslmode=require"

# --- Auth ---
# Long random string. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Admin bootstrap (used only by the seed script) ---
ADMIN_EMAIL="maya@mayaslodge.ie"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Maya"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Booking emails (Resend, https://resend.com) ---
# Without a verified domain, emails can only go to the Resend account's own address.
RESEND_API_KEY=""
# Optional overrides (defaults: Admin → Settings email, Resend test sender)
NOTIFY_EMAIL=""
EMAIL_FROM=""
